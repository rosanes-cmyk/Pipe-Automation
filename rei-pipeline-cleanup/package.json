{
  "name": "rei-pipeline-cleanup",
  "version": "0.1.7",
  "description": "REI BlackBook Property Pipeline status cleanup automation (Node.js + Playwright)",
  "type": "commonjs",
  "main": "electron-main.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "app": "electron .",
    "dist": "electron-builder --win nsis",
    "audit": "node app.js --audit",
    "live": "node app.js --live",
    "dashboard": "node dashboard.js",
    "serve": "node serve.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.twinhomebuyer.pipelinecleanup",
    "productName": "Pipeline Status Cleanup",
    "asar": false,
    "files": ["**/*", "!reports/**", "!data/**", "!logs/**", "!screenshots/**", "!.chrome-profile/**", "!dist/**"],
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pipeline Status Cleanup"
    }
  }
}
