# ---------------------------------------------------------------------------
# Pipe-Automation configuration
# Copy to `.env` and fill in. Never commit the real .env (see .gitignore).
# ---------------------------------------------------------------------------

# Data source: "fixture" runs against bundled sample data (no network, safe to
# demo). "rei" hits the live REI BlackBook API.
DATA_SOURCE=fixture

# --- REI BlackBook API (only used when DATA_SOURCE=rei) --------------------
# CONFIRM these against the REI developer portal: https://developer.blackbookcloud.com/
# The portal is credential-gated; the values below are the integration points,
# not verified endpoints. Correct paths/auth in pipeline_automation/rei_client.py.
REI_API_BASE_URL=https://api.blackbookcloud.com
REI_API_KEY=
# Auth style REI expects: "bearer" (Authorization: Bearer <key>) or "header"
# (X-API-Key: <key>). Confirm with the portal.
REI_AUTH_STYLE=bearer
REI_REQUEST_TIMEOUT=30

# --- Run behaviour ---------------------------------------------------------
# How many records to process before writing a checkpoint.
CHECKPOINT_EVERY=25
# Page size when paging the pipeline.
PAGE_SIZE=100
# Max retries for a single record's set -> reload -> verify cycle.
MAX_VERIFY_RETRIES=3
# Set to "true" to compute decisions WITHOUT writing anything back to REI.
DRY_RUN=true
# SQLite file holding run state / checkpoints.
STATE_DB=./run_state.db

# --- Market Status mapping (REI "Market Status" -> pipeline stage) ---------
# Evaluating is confirmed. The others are OPEN ITEMS (SOP v2 section 8) until
# Jonathan confirms them; leave blank to make the runner HOLD + flag those
# leads for manual review instead of guessing.
MARKET_STATUS_EVALUATING=Follow up
MARKET_STATUS_UNDER_CONTRACT=
MARKET_STATUS_CLOSED_WON=
MARKET_STATUS_CLOSED_DEAD=
